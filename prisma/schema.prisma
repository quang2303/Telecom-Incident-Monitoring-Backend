generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  role              UserRole   @default(OPERATOR)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  refreshToken      String?
  username          String?    @unique
  isActive          Boolean    @default(true)
  region            String?
  assignedIncidents Incident[] @relation("IncidentAssignee")
}

model Site {
  id           String     @id @default(uuid())
  code         String     @unique
  externalCode String?    @unique
  name         String
  region       String?
  address      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  devices      Device[]
  incidents    Incident[]
}

model Device {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  code      String     @unique
  siteId    String
  type      String?
  vendor    String?
  region    String?
  site      Site       @relation(fields: [siteId], references: [id])
  incidents Incident[]

  @@index([siteId])
}

model Incident {
  id                    String                    @id @default(uuid())
  externalIncidentId    String?                   @unique
  sourceSystem          ImportSourceSystem        @default(MANUAL)
  title                 String?
  description           String?
  importedFaultSeverity Int?
  internalStatus        IncidentInternalStatus    @default(NEW)
  siteId                String
  deviceId              String?
  importJobId           String?
  importedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  assigneeId            String?
  assignee              User?                     @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  device                Device?                   @relation(fields: [deviceId], references: [id])
  importJob             ImportJob?                @relation(fields: [importJobId], references: [id])
  site                  Site                      @relation(fields: [siteId], references: [id])
  analysis              IncidentAnalysis?
  events                IncidentEventType[]
  logs                  IncidentLog[]
  features              IncidentLogFeature[]
  resources             IncidentResourceType[]
  severitiesRaw         IncidentSeverityTypeRaw[]

  @@index([siteId])
  @@index([internalStatus])
  @@index([importedFaultSeverity])
  @@index([assigneeId])
}

model IncidentLog {
  id         String   @id @default(uuid())
  incidentId String
  message    String
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
}

model ImportJob {
  id           String             @id @default(uuid())
  sourceSystem ImportSourceSystem
  status       ImportJobStatus    @default(PENDING)
  totalRecords Int                @default(0)
  errorMessage String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  incidents    Incident[]

  @@index([status])
  @@index([createdAt])
}

model IncidentEventType {
  id         String   @id @default(uuid())
  incidentId String
  eventType  String
  incident   Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([eventType])
}

model IncidentLogFeature {
  id         String   @id @default(uuid())
  incidentId String
  logFeature String
  volume     Int
  incident   Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([logFeature])
}

model IncidentResourceType {
  id           String   @id @default(uuid())
  incidentId   String
  resourceType String
  incident     Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([resourceType])
}

model IncidentSeverityTypeRaw {
  id           String   @id @default(uuid())
  incidentId   String
  severityType String
  incident     Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([severityType])
}

model TelstraTrainRaw {
  id             String   @id
  location       String
  fault_severity Int
  importJobId    String?
  createdAt      DateTime @default(now())
}

model TelstraEventTypeRaw {
  rawId       String   @id @default(uuid())
  id          String
  event_type  String
  importJobId String?
  createdAt   DateTime @default(now())

  @@index([id])
}

model TelstraLogFeatureRaw {
  rawId       String   @id @default(uuid())
  id          String
  log_feature String
  volume      Int
  importJobId String?
  createdAt   DateTime @default(now())

  @@index([id])
}

model TelstraResourceTypeRaw {
  rawId         String   @id @default(uuid())
  id            String
  resource_type String
  importJobId   String?
  createdAt     DateTime @default(now())

  @@index([id])
}

model TelstraSeverityTypeRaw {
  rawId         String   @id @default(uuid())
  id            String
  severity_type String
  importJobId   String?
  createdAt     DateTime @default(now())

  @@index([id])
}

model IncidentAnalysis {
  id                        String   @id @default(uuid())
  incidentId                String   @unique
  category                  String
  suggestedInternalPriority String
  shortSummary              String
  possibleCause             String
  suggestedAction           String
  confidence                Float?
  rawModel                  String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  incident                  Incident @relation(fields: [incidentId], references: [id])
}

enum UserRole {
  ADMIN
  OPERATOR
  TECHNICIAN
}

enum IncidentInternalStatus {
  NEW
  REVIEWING
  ACKNOWLEDGED
  RESOLVED
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportSourceSystem {
  TELSTRA_CSV
  MANUAL
}
